NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key for privileged operations (device management, admin APIs).
# Find it in Supabase Dashboard → Settings → API → service_role key.
# NEVER prefix with NEXT_PUBLIC_ — this key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Anthropic API key for POA name and address translation.
ANTHROPIC_API_KEY=
# Optional server-side Anthropic model override.
TRANSLATE_MODEL=

# Server-only LibreTranslate URL (self-hosted on EC2, primary translator for POA).
LIBRETRANSLATE_URL=

# Server-only Google Cloud Translation API key (fallback if LibreTranslate is unavailable).
GOOGLE_TRANSLATE_API_KEY=

# Server-only URL for the secured LibreOffice-backed Gotenberg PDF converter.
GOTENBERG_URL=

# Optional public frontend origin for QR links generated from local/preview URLs.
NEXT_PUBLIC_SITE_URL=https://aiptconnect.aiptlaw.com
